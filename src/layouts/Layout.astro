---
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';
import logoImg from '../assets/logo.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Emit `noindex` and skip canonical/og:url (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title = 'BLOQ Media | Shaping Tech Narratives in Southeast Asia',
  description =
    'BLOQ Media covers tech and blockchain in Southeast Asia, with news, content strategy, and digital marketing for the region\'s most innovative companies.',
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

// Astro.site is the single source of truth for the production origin
// (https://www.bloq.media), so every absolute URL below stays in sync with it.
const siteUrl = new URL('/', Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const absoluteOgImage = new URL(ogImage, Astro.site).href;
const absoluteLogo = new URL(logoImg.src, Astro.site).href;
const orgId = `${siteUrl}#organization`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'NewsMediaOrganization'],
  '@id': orgId,
  name: 'BLOQ Media',
  url: siteUrl,
  logo: absoluteLogo,
  description:
    'BLOQ Media is a news organization and digital marketing agency specializing in tech and blockchain in Southeast Asia.',
  email: 'hello@bloq.media',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'hello@bloq.media',
    url: `${siteUrl}#contact`,
    availableLanguage: 'English',
  },
  areaServed: 'Southeast Asia',
  sameAs: [
    'https://x.com/_BLOQMedia',
    'https://www.linkedin.com/company/bloq-media/',
    'https://medium.com/@bloqmedia',
  ],
  knowsAbout: ['Blockchain', 'Technology', 'Digital Marketing', 'Content Strategy', 'Fintech', 'Web3'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'BLOQ Media',
  url: siteUrl,
  description: 'News organization and digital marketing agency for tech and blockchain in Southeast Asia',
  publisher: { '@id': orgId },
};
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A3C8F" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content="BLOQ Media" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content="BLOQ Media" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BLOQ Media — Shaping Tech Narratives in Southeast Asia" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@_BLOQMedia" />
    <meta name="twitter:creator" content="@_BLOQMedia" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="BLOQ Media — Shaping Tech Narratives in Southeast Asia" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: Inter is self-hosted via Astro's Fonts API (see astro.config.mjs).
         Preload the body (400) and headline (700) weights; the others load on
         demand. The generated fallback font is metric-matched to Inter so the
         swap doesn't cause layout shift. -->
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }, { weight: 700 }]} />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Gate scroll-animation hidden state: elements stay visible if JS never runs -->
    <script is:inline>document.documentElement.classList.add('js-ready');</script>
  </head>
  <body class="font-sans antialiased text-gray-900 bg-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-bloq-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>
    <slot />
    <Analytics />

    <script>
      // Scroll-triggered entrance animations
      const animateObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            // After the entrance completes, clear stagger delay so hover
            // transitions on cards aren't delayed on subsequent interactions.
            setTimeout(() => {
              (entry.target as HTMLElement).style.transitionDelay = '';
            }, 1000);
            animateObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-animate]').forEach((el) => animateObserver.observe(el));
    </script>
  </body>
</html>
