---
import { Image } from 'astro:assets';
import Icon from '@components/Icon.astro';
import logo from '@assets/logo.png';
import { CONTACT_SECTION_ID, SITE_NAME, sectionHref, sections, socials } from '@lib/site';

// Build-time year; the script below refreshes it in the browser since the
// pages are prerendered and would otherwise show the year of the last deploy.
const year = new Date().getFullYear();

const { pathname } = Astro.url;
const links = [...sections, { id: CONTACT_SECTION_ID, label: 'Contact' }];
---

<footer class="bg-gray-950 text-white">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-10">

      <div class="flex flex-col items-center md:items-start gap-4">
        <Image src={logo} alt={SITE_NAME} height={64} class="h-8 w-auto brightness-0 invert opacity-90" />
        <p class="text-gray-400 text-sm max-w-xs text-center md:text-left leading-relaxed">
          Shaping tech narratives in Southeast Asia through authoritative reporting and strategic content.
        </p>
        <div class="flex items-center gap-4 mt-1">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="text-gray-500 hover:text-white transition-colors duration-200"
            >
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      <nav class="flex flex-wrap justify-center md:justify-end gap-x-8 gap-y-3">
        {links.map((link) => (
          <a href={sectionHref(link.id, pathname)} class="text-gray-400 hover:text-white text-sm transition-colors duration-200">
            {link.label}
          </a>
        ))}
      </nav>

    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col items-center gap-3">
      <div class="flex items-center gap-6">
        <a
          href="/privacy"
          class="text-gray-500 hover:text-white text-sm transition-colors duration-200 underline-offset-2 hover:underline"
        >
          Privacy Policy
        </a>
        <a
          href="/terms"
          class="text-gray-500 hover:text-white text-sm transition-colors duration-200 underline-offset-2 hover:underline"
        >
          Terms of Service
        </a>
      </div>
      <p class="text-gray-500 text-sm">
        &copy; <span id="copyright-year">{year}</span> BLOQ Media. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  const yearEl = document.getElementById('copyright-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
