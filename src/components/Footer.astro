---
import { Image } from 'astro:assets';
import logo from '@assets/logo.png';
import { CONTACT_SECTION_ID, SITE_NAME, sectionHref, sections, socials } from '@lib/site';

// Build-time year; the script below refreshes it in the browser since the
// pages are prerendered and would otherwise show the year of the last deploy.
const year = new Date().getFullYear();

const { pathname } = Astro.url;
const allSections = [...sections, { id: CONTACT_SECTION_ID, label: 'Contact' }];
const pick = (ids: string[]) =>
  ids.map((id) => {
    const section = allSections.find((s) => s.id === id)!;
    return { label: section.label, href: sectionHref(id, pathname) };
  });

const columns = [
  { title: 'Company', links: pick(['about', 'why', 'clients']) },
  { title: 'Work', links: pick(['services', 'articles', CONTACT_SECTION_ID]) },
  {
    title: 'Follow',
    links: socials.map((s) => ({ label: s.label, href: s.href, external: true })),
  },
];
---

<footer class="bg-bloq-dark text-white">
  <div class="max-w-7xl mx-auto px-6 pt-14 pb-8">
    <div class="grid grid-cols-3 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] gap-x-4 gap-y-8 sm:gap-8">
      <div class="col-span-3 sm:col-span-1 flex flex-col gap-3.5">
        <Image
          src={logo}
          alt={SITE_NAME}
          height={64}
          class="h-8 w-auto self-start brightness-0 invert"
        />
        <p class="max-w-xs text-[15px] leading-relaxed text-bloq-mist">
          Shaping tech narratives in Southeast Asia through authoritative reporting and strategic
          content.
        </p>
      </div>

      {columns.map((column) => (
        <nav aria-label={column.title} class="flex flex-col md:gap-2.5 text-[15px]">
          <h2 class="mb-1 text-[13px] font-bold uppercase tracking-[0.1em] text-bloq-blue-light">
            {column.title}
          </h2>
          {column.links.map((link) => (
            <a
              href={link.href}
              {...('external' in link && { target: '_blank', rel: 'noopener noreferrer' })}
              class="self-start inline-flex items-center min-h-11 md:min-h-0 text-white/90 hover:text-white hover:underline underline-offset-4"
            >
              {link.label}
            </a>
          ))}
        </nav>
      ))}
    </div>

    <div class="mt-10 pt-6 border-t border-white/15 flex flex-col sm:flex-row items-center sm:justify-between gap-3 text-sm text-[#a9b9d9]">
      <p>
        &copy; <span id="copyright-year">{year}</span> BLOQ Media. All rights reserved.
      </p>
      <div class="flex items-center gap-5">
        <a
          href="/privacy"
          class="inline-flex items-center min-h-11 sm:min-h-0 hover:text-white underline-offset-2 hover:underline"
        >
          Privacy Policy
        </a>
        <a
          href="/terms"
          class="inline-flex items-center min-h-11 sm:min-h-0 hover:text-white underline-offset-2 hover:underline"
        >
          Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const yearEl = document.getElementById('copyright-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
