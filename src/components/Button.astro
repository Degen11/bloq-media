---
import type { HTMLAttributes } from 'astro/types';

// Shared button styles. Renders an <a> when `href` is set, else a <button>.
//   primary    navy, the main call to action on light backgrounds
//   secondary  white with a border, on light backgrounds
//   ghost      bordered, on navy backgrounds
//   light      white, the main call to action on navy backgrounds
type Variant = 'primary' | 'secondary' | 'ghost' | 'light';
type Size = 'sm' | 'md' | 'lg';

type Props = HTMLAttributes<'a'> &
  HTMLAttributes<'button'> & {
    variant?: Variant;
    size?: Size;
  };

const { variant = 'primary', size = 'md', href, class: className, ...attrs } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-bloq-navy text-white hover:bg-bloq-dark',
  secondary: 'border border-bloq-line-strong bg-white text-bloq-dark hover:bg-bloq-tint',
  ghost: 'border border-white/25 text-white hover:bg-white/10',
  light: 'bg-white text-bloq-dark hover:bg-bloq-sky',
};

const sizes: Record<Size, string> = {
  sm: 'px-5 py-2.5 rounded-[10px] text-[15px]',
  md: 'px-5 py-3 rounded-xl text-[15px]',
  lg: 'px-6 py-4 rounded-xl text-base',
};

const classes = [
  'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-200 active:scale-[0.97] disabled:opacity-60 disabled:cursor-not-allowed',
  variants[variant],
  sizes[size],
  className,
];
---

{href ? (
  <a href={href} class:list={classes} {...attrs}>
    <slot />
  </a>
) : (
  <button type="button" class:list={classes} {...attrs}>
    <slot />
  </button>
)}
