---
import type { HTMLAttributes } from 'astro/types';

// Shared button styles. Renders an <a> when `href` is set, else a <button>.
//   primary  navy, for light backgrounds
//   accent   bloq-blue, the hero call to action
//   outline  bordered, for light backgrounds
//   ghost    bordered, for dark (navy) backgrounds
type Variant = 'primary' | 'accent' | 'outline' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

type Props = (HTMLAttributes<'a'> & HTMLAttributes<'button'>) & {
  variant?: Variant;
  size?: Size;
};

const { variant = 'primary', size = 'md', href, class: className, ...attrs } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-bloq-navy text-white hover:bg-bloq-dark',
  accent: 'bg-bloq-blue text-white hover:bg-bloq-blue/90 shadow-lg shadow-bloq-blue/25',
  outline: 'border border-gray-200 text-gray-900 hover:bg-gray-50',
  ghost: 'border border-white/25 text-white hover:bg-white/10',
};

const sizes: Record<Size, string> = {
  sm: 'px-5 py-2 rounded-lg text-sm',
  md: 'px-6 py-3.5 rounded-xl text-base',
  lg: 'px-8 py-4 rounded-xl text-base',
};

const classes = [
  'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-200 active:scale-[0.97] disabled:opacity-60 disabled:cursor-not-allowed',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...attrs}>
      <slot />
    </button>
  )
}
