---
import { Image } from 'astro:assets';
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import logo from '@assets/logo.png';
import { latestArticle } from '@lib/articles';
import {
  CONTACT_EMAIL,
  CONTACT_SECTION_ID,
  SITE_NAME,
  sectionHref,
  sections,
  socials,
} from '@lib/site';

const { pathname } = Astro.url;
const contactHref = sectionHref(CONTACT_SECTION_ID, pathname);
---

<!-- Utility bar: scrolls away; only the header below it sticks -->
<div class="bg-bloq-dark text-[13px] text-[#dce6f7]">
  <div class="max-w-7xl mx-auto px-6 h-[38px] flex items-center justify-between gap-4">
    <p class="self-stretch flex items-center gap-2.5 min-w-0">
      <span class="w-[7px] h-[7px] shrink-0 rounded-full bg-bloq-blue" aria-hidden="true"></span>
      <span class="truncate">New on Medium: {latestArticle.shortTitle}</span>
      <a
        href={latestArticle.url}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 self-stretch flex items-center px-2 -mx-2 font-semibold text-white underline underline-offset-[3px] hover:text-bloq-blue-light"
      >
        Read it
      </a>
    </p>
    <div class="hidden md:flex items-center gap-[18px]">
      <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-white transition-colors">
        {CONTACT_EMAIL}
      </a>
      <span class="w-px h-3.5 bg-white/25" aria-hidden="true"></span>
      {socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${SITE_NAME} on ${social.label}`}
          class="flex hover:text-white transition-colors"
        >
          <Icon name={social.icon} class="w-3.5 h-3.5" />
        </a>
      ))}
    </div>
  </div>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-bloq-line"
>
  <div class="max-w-7xl mx-auto px-6 h-[60px] md:h-[72px] flex items-center justify-between">
    <a href="/" aria-label="BLOQ Media Home">
      <Image
        src={logo}
        alt={SITE_NAME}
        height={68}
        loading="eager"
        class="h-[30px] md:h-[34px] w-auto"
      />
    </a>

    <nav class="hidden md:flex items-center gap-[30px]">
      {sections.map((section) => (
        <a
          href={sectionHref(section.id, pathname)}
          data-section={section.id}
          class="text-bloq-slate hover:text-bloq-dark text-[15px] font-medium transition-colors duration-200"
        >
          {section.label}
        </a>
      ))}
      <Button href={contactHref} size="sm">
        Contact us
        <Icon name="arrow-right" class="w-4 h-4" />
      </Button>
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden text-bloq-dark p-2.5 -mr-2.5"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          id="icon-open"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
        <path
          id="icon-close"
          class="hidden"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    inert
    class="md:hidden border-t border-bloq-line overflow-hidden"
    style="max-height: 0; opacity: 0; transition: max-height 0.3s ease, opacity 0.3s ease;"
  >
    <div class="px-6 py-4 flex flex-col gap-1">
      {sections.map((section) => (
        <a
          href={sectionHref(section.id, pathname)}
          data-section={section.id}
          class="block py-3 text-gray-600 hover:text-bloq-dark text-base font-medium"
        >
          {section.label}
        </a>
      ))}
      <Button href={contactHref} class="mt-2">
        Contact us
      </Button>
    </div>
  </div>
</header>

<script>
  import { CONTACT_SECTION_ID, sections } from '@lib/site';

  // ── Mobile menu slide animation ──────────────────────────────────────────
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  let menuOpen = false;
  // Scroll position when the menu opened, so scrolling away can close it
  let openedAtY = 0;

  function openMenu() {
    if (!menu) return;
    menuOpen = true;
    openedAtY = window.scrollY;
    menu.inert = false;
    menu.style.maxHeight = menu.scrollHeight + 'px';
    menu.style.opacity = '1';
    toggle?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  }

  function closeMenu() {
    if (!menu) return;
    menuOpen = false;
    // Collapsed links are invisible but would still take Tab focus without this
    menu.inert = true;
    menu.style.maxHeight = '0';
    menu.style.opacity = '0';
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  toggle?.addEventListener('click', () => {
    if (menuOpen) closeMenu();
    else openMenu();
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Tapping anywhere outside the open menu closes it
  document.addEventListener('click', (e) => {
    if (!menuOpen) return;
    const target = e.target as Node;
    if (menu?.contains(target) || toggle?.contains(target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      closeMenu();
      toggle?.focus();
    }
  });

  // ── Scroll-aware navbar shadow ────────────────────────────────────────────
  const header = document.getElementById('site-header');

  // ── Scroll-spy: highlight the nav link for the current section ────────────
  // Contact is spied too, so no nav link stays highlighted over the form
  const spySectionIds = [...sections.map((s) => s.id), CONTACT_SECTION_ID];
  const spyLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section]');

  // Picks the lowest section whose top has passed the navbar. Compares page
  // positions rather than relying on list order, since the nav order doesn't
  // match the page order (Clients sits right under the hero).
  function getActiveSection(): string {
    const navHeight = header?.offsetHeight ?? 80;
    // Extra buffer so the link activates just before the section top hits the navbar
    const line = window.scrollY + navHeight + 32;
    let active = '';
    let activeTop = -Infinity;
    for (const id of spySectionIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const top = el.getBoundingClientRect().top + window.scrollY;
      if (top <= line && top > activeTop) {
        active = id;
        activeTop = top;
      }
    }
    return active;
  }

  function updateScrollSpy() {
    const active = getActiveSection();
    spyLinks.forEach((link) => {
      link.classList.toggle('nav-active', link.dataset.section === active);
    });
  }

  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 10) {
        header?.classList.add('header-scrolled');
      } else {
        header?.classList.remove('header-scrolled');
      }
      updateScrollSpy();
      // Small threshold so mobile address-bar jitter doesn't close the menu
      if (menuOpen && Math.abs(window.scrollY - openedAtY) > 40) closeMenu();
    },
    { passive: true },
  );

  // Run once on load so the active state reflects any deep-link or page-load scroll position
  updateScrollSpy();
</script>
