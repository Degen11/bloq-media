---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

// Section anchors live on the homepage, so prefix them with "/" on other pages
// (privacy, terms, 404) or they'd point at sections that don't exist there.
const home = Astro.url.pathname === '/' ? '' : '/';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" aria-label="BLOQ Media Home">
      <Image src={logo} alt="BLOQ Media" height={72} loading="eager" class="h-9 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-8">
      <a href={`${home}#about`} data-section="about" class="text-gray-500 hover:text-gray-900 text-sm font-medium transition-colors duration-200">About</a>
      <a href={`${home}#why`} data-section="why" class="text-gray-500 hover:text-gray-900 text-sm font-medium transition-colors duration-200">Why BLOQ</a>
      <a href={`${home}#services`} data-section="services" class="text-gray-500 hover:text-gray-900 text-sm font-medium transition-colors duration-200">Services</a>
      <a href={`${home}#articles`} data-section="articles" class="text-gray-500 hover:text-gray-900 text-sm font-medium transition-colors duration-200">Articles</a>
      <a href={`${home}#clients`} data-section="clients" class="text-gray-500 hover:text-gray-900 text-sm font-medium transition-colors duration-200">Clients</a>
      <a
        href={`${home}#contact`}
        class="bg-bloq-navy text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-bloq-dark transition-colors duration-200"
      >
        Contact Us
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden text-gray-700 p-2.5 -mr-2.5"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        <path id="icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    inert
    class="md:hidden border-t border-gray-100 overflow-hidden"
    style="max-height: 0; opacity: 0; transition: max-height 0.3s ease, opacity 0.3s ease;"
  >
    <div class="px-6 py-4 flex flex-col gap-1">
      <a href={`${home}#about`} data-section="about" class="block py-3 text-gray-600 hover:text-gray-900 text-base font-medium">About</a>
      <a href={`${home}#why`} data-section="why" class="block py-3 text-gray-600 hover:text-gray-900 text-base font-medium">Why BLOQ</a>
      <a href={`${home}#services`} data-section="services" class="block py-3 text-gray-600 hover:text-gray-900 text-base font-medium">Services</a>
      <a href={`${home}#articles`} data-section="articles" class="block py-3 text-gray-600 hover:text-gray-900 text-base font-medium">Articles</a>
      <a href={`${home}#clients`} data-section="clients" class="block py-3 text-gray-600 hover:text-gray-900 text-base font-medium">Clients</a>
      <a
        href={`${home}#contact`}
        class="mt-2 bg-bloq-navy text-white px-5 py-3 rounded-lg text-base font-semibold text-center"
      >
        Contact Us
      </a>
    </div>
  </div>
</header>

<script>
  // ── Mobile menu slide animation ──────────────────────────────────────────
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  let menuOpen = false;
  // Scroll position when the menu opened, so scrolling away can close it
  let openedAtY = 0;

  function openMenu() {
    if (!menu) return;
    menuOpen = true;
    openedAtY = window.scrollY;
    menu.inert = false;
    menu.style.maxHeight = menu.scrollHeight + 'px';
    menu.style.opacity = '1';
    toggle?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  }

  function closeMenu() {
    if (!menu) return;
    menuOpen = false;
    // Collapsed links are invisible but would still take Tab focus without this
    menu.inert = true;
    menu.style.maxHeight = '0';
    menu.style.opacity = '0';
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  toggle?.addEventListener('click', () => {
    menuOpen ? closeMenu() : openMenu();
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Tapping anywhere outside the open menu closes it
  document.addEventListener('click', (e) => {
    if (!menuOpen) return;
    const target = e.target as Node;
    if (menu?.contains(target) || toggle?.contains(target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      closeMenu();
      toggle?.focus();
    }
  });

  // ── Scroll-aware navbar shadow ────────────────────────────────────────────
  const header = document.getElementById('site-header');

  // ── Scroll-spy: highlight the nav link for the current section ────────────
  const spySectionIds = ['about', 'why', 'services', 'articles', 'clients', 'contact'];
  const spyLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section]');

  function getActiveSection(): string {
    const navHeight = header?.offsetHeight ?? 80;
    // Extra buffer so the link activates just before the section top hits the navbar
    const offset = navHeight + 32;
    let active = '';
    for (const id of spySectionIds) {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - offset) {
        active = id;
      }
    }
    return active;
  }

  function updateScrollSpy() {
    const active = getActiveSection();
    spyLinks.forEach((link) => {
      link.classList.toggle('nav-active', link.dataset.section === active);
    });
  }

  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 10) {
        header?.classList.add('header-scrolled');
      } else {
        header?.classList.remove('header-scrolled');
      }
      updateScrollSpy();
      // Small threshold so mobile address-bar jitter doesn't close the menu
      if (menuOpen && Math.abs(window.scrollY - openedAtY) > 40) closeMenu();
    },
    { passive: true },
  );

  // Run once on load so the active state reflects any deep-link or page-load scroll position
  updateScrollSpy();
</script>
