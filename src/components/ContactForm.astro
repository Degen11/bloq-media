---
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import { INTERESTS, MAX_LENGTH } from '@lib/contact';
import { CONTACT_EMAIL } from '@lib/site';

const steps = ['Tell us about your project', 'We reply by email', 'We scope a plan together'];

// text-base on mobile: iOS Safari auto-zooms focused fields with font-size < 16px
const inputClass =
  'w-full px-3.5 py-3 border border-bloq-line-strong rounded-xl bg-[#fbfcfe] text-bloq-ink placeholder-bloq-muted text-base sm:text-[15px] focus:outline-none focus:ring-2 focus:ring-bloq-blue focus:border-transparent transition-shadow aria-[invalid=true]:border-red-400 aria-[invalid=true]:ring-red-300';
const labelClass = 'block text-sm font-semibold text-bloq-ink mb-1.5';
---

<Section id="contact" class="bg-white">
  <div
    data-animate
    class="grid lg:grid-cols-[0.9fr_1.1fr] rounded-[28px] border border-[#dce5f2] overflow-hidden shadow-[0_1px_2px_rgb(15_34_96/0.06),0_30px_60px_-30px_rgb(15_34_96/0.35)]"
  >
    <!-- Left: copy + contact details -->
    <div class="bg-bloq-sky bg-dots p-7 sm:p-11 flex flex-col gap-6">
      <SectionHeading eyebrow="Get in touch" title="Ready to make an impact?">
        Whether you need a news partner, a content studio, or a full campaign, we're ready to talk.
      </SectionHeading>

      <ol class="flex flex-col gap-3.5" aria-label="What happens next">
        {steps.map((step, i) => (
          <li class="flex items-center gap-3.5 text-[15px] text-bloq-ink">
            <span
              class="shrink-0 w-8 h-8 rounded-full bg-bloq-navy text-white text-sm font-bold flex items-center justify-center"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            {step}
          </li>
        ))}
      </ol>

      <div class="mt-auto rounded-[14px] border border-[#d7e2f2] bg-white px-4 py-3.5 flex items-center justify-between gap-3">
        <div>
          <p class="text-xs text-bloq-muted">Prefer email?</p>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="font-bold text-bloq-dark hover:text-bloq-navy transition-colors"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
        <button
          id="copy-email-btn"
          type="button"
          aria-label="Copy email address"
          title="Copy email address"
          class="shrink-0 w-11 h-11 rounded-[10px] border border-[#d7e2f2] bg-bloq-tint text-bloq-navy hover:bg-bloq-sky flex items-center justify-center transition-colors"
        >
          <span class="copy-icon-stack" aria-hidden="true">
            <Icon name="clipboard" id="copy-icon" class="copy-icon-layer" />
            <Icon
              name="check"
              id="check-icon"
              class="copy-icon-layer text-green-600"
              stroke-width="2.5"
            />
          </span>
        </button>
        <span id="copy-status" class="sr-only" aria-live="polite"></span>
      </div>
    </div>

    <!-- Right: form -->
    <div class="bg-white p-7 sm:p-11">
      <form id="contact-form" novalidate class="flex flex-col gap-[18px]">
        <!-- Honeypot: hidden from humans, bots fill it in -->
        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class={labelClass}>
              Name{' '}
              <span class="text-bloq-link" aria-hidden="true">
                *
              </span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              maxlength={MAX_LENGTH.name}
              placeholder="Jane Smith"
              aria-required="true"
              aria-describedby="name-error"
              class={inputClass}
            />
            <div id="name-error" class="hidden mt-1 text-red-600 text-xs" role="alert"></div>
          </div>
          <div>
            <label for="email" class={labelClass}>
              Email{' '}
              <span class="text-bloq-link" aria-hidden="true">
                *
              </span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              maxlength={MAX_LENGTH.email}
              placeholder="jane@company.com"
              aria-required="true"
              aria-describedby="email-error"
              class={inputClass}
            />
            <div id="email-error" class="hidden mt-1 text-red-600 text-xs" role="alert"></div>
          </div>
        </div>

        <div>
          <label for="company" class={labelClass}>
            Company <span class="font-normal text-bloq-muted">(optional)</span>
          </label>
          <input
            type="text"
            id="company"
            name="company"
            autocomplete="organization"
            maxlength={MAX_LENGTH.company}
            placeholder="Your company"
            class={inputClass}
          />
        </div>

        <fieldset>
          <legend class={labelClass}>
            What do you need? <span class="font-normal text-bloq-muted">(optional)</span>
          </legend>
          <div class="flex flex-wrap gap-2">
            {INTERESTS.map((interest) => (
              <label class="cursor-pointer">
                <input type="radio" name="interest" value={interest} class="peer sr-only" />
                <span class="inline-flex items-center min-h-11 rounded-full border border-bloq-line-strong bg-white px-4 text-sm font-semibold text-bloq-navy transition-colors hover:bg-bloq-tint peer-checked:border-bloq-navy peer-checked:bg-bloq-navy peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-bloq-blue">
                  {interest}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="message" class={labelClass}>
            Message{' '}
            <span class="text-bloq-link" aria-hidden="true">
              *
            </span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="4"
            maxlength={MAX_LENGTH.message}
            placeholder="Tell us about your project or what you're looking for…"
            aria-required="true"
            aria-describedby="message-error"
            class={`${inputClass} resize-none`}
          ></textarea>
          <div id="message-error" class="hidden mt-1 text-red-600 text-xs" role="alert"></div>
        </div>

        <Button type="submit" id="submit-btn" size="lg" class="w-full font-bold">
          <span id="btn-label">Send message</span>
          <Icon name="arrow-right" id="btn-arrow" class="w-[18px] h-[18px]" />
          <Icon name="spinner" id="btn-spinner" class="hidden w-4 h-4 animate-spin" />
        </Button>

        <div
          id="form-error"
          class="hidden p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"
          role="alert"
        >
          Something went wrong. Please try again or email us at {CONTACT_EMAIL}.
        </div>
      </form>

      <!-- Success state (replaces form) -->
      <div id="form-success" class="hidden py-10 text-center" role="status">
        <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-5">
          <Icon name="check" class="w-8 h-8 text-green-600" />
        </div>
        <h3 class="text-xl font-bold text-bloq-dark mb-2">Message sent!</h3>
        <p class="text-bloq-slate text-sm">Thanks for reaching out. We'll be in touch shortly.</p>
      </div>
    </div>
  </div>
</Section>

<script>
  import { track } from '@vercel/analytics';
  import { EMAIL_RE } from '@lib/contact';
  import { CONTACT_EMAIL } from '@lib/site';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnLabel = document.getElementById('btn-label');
  const btnArrow = document.getElementById('btn-arrow');
  const btnSpinner = document.getElementById('btn-spinner');
  const formError = document.getElementById('form-error');
  const formSuccess = document.getElementById('form-success');
  const genericError = formError?.textContent?.trim() ?? '';

  function setLoading(loading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    btnLabel!.textContent = loading ? 'Sending…' : 'Send message';
    btnArrow?.classList.toggle('hidden', loading);
    btnSpinner?.classList.toggle('hidden', !loading);
  }

  function setFieldError(name: string, message: string) {
    const input = form?.elements.namedItem(name) as HTMLElement | null;
    const errorEl = document.getElementById(`${name}-error`);
    input?.setAttribute('aria-invalid', 'true');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    // Trigger shake — remove first to allow re-trigger on repeated submit
    if (input) {
      input.classList.remove('field-shake');
      void (input as HTMLElement).offsetWidth; // force reflow so animation restarts
      input.classList.add('field-shake');
      input.addEventListener('animationend', () => input.classList.remove('field-shake'), {
        once: true,
      });
    }
  }

  function clearFieldError(name: string) {
    const input = form?.elements.namedItem(name) as HTMLElement | null;
    const errorEl = document.getElementById(`${name}-error`);
    input?.removeAttribute('aria-invalid');
    if (errorEl) {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }
  }

  // Clear field error on user input
  (['name', 'email', 'message'] as const).forEach((field) => {
    const el = form?.elements.namedItem(field) as HTMLElement | null;
    el?.addEventListener('input', () => clearFieldError(field));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Clear all errors
    (['name', 'email', 'message'] as const).forEach(clearFieldError);
    formError?.classList.add('hidden');

    // Validate
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const company = (form.elements.namedItem('company') as HTMLInputElement).value.trim();
    const website = (form.elements.namedItem('website') as HTMLInputElement).value;
    const interest = (form.elements.namedItem('interest') as RadioNodeList | null)?.value ?? '';

    let hasErrors = false;
    if (!name) {
      setFieldError('name', 'Name is required.');
      hasErrors = true;
    }
    if (!email || !EMAIL_RE.test(email)) {
      setFieldError('email', 'A valid email address is required.');
      hasErrors = true;
    }
    if (!message) {
      setFieldError('message', 'Message is required.');
      hasErrors = true;
    }
    if (hasErrors) return;

    setLoading(true);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ name, email, company, interest, message, website }),
      });

      const data = await res.json();

      if (data.success) {
        form.classList.add('hidden');
        formSuccess?.classList.remove('hidden');
        track('contact_form_submitted');
      } else {
        // Show the server's reason (e.g. the rate-limit notice) instead of the generic text
        if (formError && typeof data.message === 'string') formError.textContent = data.message;
        formError?.classList.remove('hidden');
        setLoading(false);
      }
    } catch {
      if (formError) formError.textContent = genericError;
      formError?.classList.remove('hidden');
      setLoading(false);
    }
  });

  // ── Click-to-copy email ──────────────────────────────────────────────────
  const copyBtn = document.getElementById('copy-email-btn');
  const copyStatus = document.getElementById('copy-status');

  if (copyBtn) {
    let copyResetTimer: ReturnType<typeof setTimeout> | undefined;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(CONTACT_EMAIL);
        copyBtn.classList.add('is-copied');
        if (copyStatus) copyStatus.textContent = 'Email address copied to clipboard';
        clearTimeout(copyResetTimer);
        copyResetTimer = setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (copyStatus) copyStatus.textContent = '';
        }, 2000);
      } catch {
        // Clipboard unavailable — open email client as fallback
        window.location.href = `mailto:${CONTACT_EMAIL}`;
      }
    });
  }
</script>
