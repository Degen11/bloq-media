---
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import { MAX_LENGTH } from '@lib/contact';
import { CONTACT_EMAIL, socials } from '@lib/site';

// text-base on mobile: iOS Safari auto-zooms focused fields with font-size < 16px
const inputClass =
  'w-full px-4 py-3 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-500 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-bloq-blue focus:border-transparent transition-shadow aria-[invalid=true]:border-red-400 aria-[invalid=true]:ring-red-300';
---

<Section
  id="contact"
  class="bg-gradient-to-br from-bloq-dark via-bloq-navy to-bloq-navy relative overflow-hidden"
  containerClass="relative"
>
  <div slot="background" class="absolute inset-0 pointer-events-none opacity-10">
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] bg-bloq-blue rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-bloq-blue rounded-full blur-3xl"></div>
  </div>

  <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
    <!-- Left: copy + contact details -->
    <div data-animate class="lg:pt-6">
      <SectionHeading tone="dark" eyebrow="Get in Touch" title="Ready to make an impact?">
        Whether you need a news partner, a content studio, or a full campaign — we're ready to talk.
      </SectionHeading>

      <div class="mt-10 flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="w-10 h-10 bg-white/10 hover:bg-bloq-blue rounded-xl flex items-center justify-center transition-colors duration-200"
          >
            <Icon name={s.icon} class="w-4 h-4 text-white" />
          </a>
        ))}
      </div>

      <div class="mt-4 flex items-center gap-3">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="text-white/60 text-sm font-medium hover:text-white/90 transition-colors duration-200"
        >
          {CONTACT_EMAIL}
        </a>
        <button
          id="copy-email-btn"
          type="button"
          aria-label="Copy email address"
          title="Copy email address"
          class="w-8 h-8 bg-white/10 hover:bg-bloq-blue rounded-lg flex items-center justify-center transition-colors duration-200 shrink-0"
        >
          <span class="copy-icon-stack" aria-hidden="true">
            <Icon name="clipboard" id="copy-icon" class="copy-icon-layer text-white" />
            <Icon
              name="check"
              id="check-icon"
              class="copy-icon-layer text-green-400"
              stroke-width="2.5"
            />
          </span>
        </button>
        <span id="copy-status" class="sr-only" aria-live="polite"></span>
      </div>
    </div>

    <!-- Right: form card -->
    <div
      data-animate
      style="transition-delay: 100ms"
      class="bg-white rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/25"
    >
      <form id="contact-form" novalidate>
        <!-- Honeypot: hidden from humans, bots fill it in -->
        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">
                Name{' '}
                <span class="text-bloq-blue" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                maxlength={MAX_LENGTH.name}
                placeholder="Jane Smith"
                aria-required="true"
                aria-describedby="name-error"
                class={inputClass}
              />
              <div id="name-error" class="hidden mt-1 text-red-600 text-xs" role="alert"></div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">
                Email{' '}
                <span class="text-bloq-blue" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                maxlength={MAX_LENGTH.email}
                placeholder="jane@company.com"
                aria-required="true"
                aria-describedby="email-error"
                class={inputClass}
              />
              <div id="email-error" class="hidden mt-1 text-red-600 text-xs" role="alert"></div>
            </div>
          </div>

          <div>
            <label for="company" class="block text-sm font-medium text-gray-700 mb-1.5">
              Company <span class="text-gray-500 font-normal">(optional)</span>
            </label>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              maxlength={MAX_LENGTH.company}
              placeholder="Your company"
              class={inputClass}
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">
              Message{' '}
              <span class="text-bloq-blue" aria-hidden="true">
                *
              </span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              maxlength={MAX_LENGTH.message}
              placeholder="Tell us about your project or what you're looking for…"
              aria-required="true"
              aria-describedby="message-error"
              class={`${inputClass} resize-none`}
            ></textarea>
            <div id="message-error" class="hidden mt-1 text-red-600 text-xs" role="alert"></div>
          </div>

          <Button type="submit" id="submit-btn" class="w-full">
            <span id="btn-label">Send Message</span>
            <Icon name="arrow-right" id="btn-arrow" class="w-4 h-4" />
            <Icon name="spinner" id="btn-spinner" class="hidden w-4 h-4 animate-spin" />
          </Button>
        </div>

        <div
          id="form-error"
          class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"
          role="alert"
        >
          Something went wrong. Please try again or email us at {CONTACT_EMAIL}.
        </div>
      </form>

      <!-- Success state (replaces form) -->
      <div id="form-success" class="hidden py-6 text-center" role="status">
        <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-5">
          <Icon name="check" class="w-8 h-8 text-green-500" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Message sent!</h3>
        <p class="text-gray-500 text-sm">Thanks for reaching out — we'll be in touch shortly.</p>
      </div>
    </div>
  </div>
</Section>

<script>
  import { track } from '@vercel/analytics';
  import { EMAIL_RE } from '@lib/contact';
  import { CONTACT_EMAIL } from '@lib/site';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnLabel = document.getElementById('btn-label');
  const btnArrow = document.getElementById('btn-arrow');
  const btnSpinner = document.getElementById('btn-spinner');
  const formError = document.getElementById('form-error');
  const formSuccess = document.getElementById('form-success');
  const genericError = formError?.textContent?.trim() ?? '';

  function setLoading(loading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    btnLabel!.textContent = loading ? 'Sending…' : 'Send Message';
    btnArrow?.classList.toggle('hidden', loading);
    btnSpinner?.classList.toggle('hidden', !loading);
  }

  function setFieldError(name: string, message: string) {
    const input = form?.elements.namedItem(name) as HTMLElement | null;
    const errorEl = document.getElementById(`${name}-error`);
    input?.setAttribute('aria-invalid', 'true');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    // Trigger shake — remove first to allow re-trigger on repeated submit
    if (input) {
      input.classList.remove('field-shake');
      void (input as HTMLElement).offsetWidth; // force reflow so animation restarts
      input.classList.add('field-shake');
      input.addEventListener('animationend', () => input.classList.remove('field-shake'), {
        once: true,
      });
    }
  }

  function clearFieldError(name: string) {
    const input = form?.elements.namedItem(name) as HTMLElement | null;
    const errorEl = document.getElementById(`${name}-error`);
    input?.removeAttribute('aria-invalid');
    if (errorEl) {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }
  }

  // Clear field error on user input
  (['name', 'email', 'message'] as const).forEach((field) => {
    const el = form?.elements.namedItem(field) as HTMLElement | null;
    el?.addEventListener('input', () => clearFieldError(field));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Clear all errors
    (['name', 'email', 'message'] as const).forEach(clearFieldError);
    formError?.classList.add('hidden');

    // Validate
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const company = (form.elements.namedItem('company') as HTMLInputElement).value.trim();
    const website = (form.elements.namedItem('website') as HTMLInputElement).value;

    let hasErrors = false;
    if (!name) {
      setFieldError('name', 'Name is required.');
      hasErrors = true;
    }
    if (!email || !EMAIL_RE.test(email)) {
      setFieldError('email', 'A valid email address is required.');
      hasErrors = true;
    }
    if (!message) {
      setFieldError('message', 'Message is required.');
      hasErrors = true;
    }
    if (hasErrors) return;

    setLoading(true);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ name, email, company, message, website }),
      });

      const data = await res.json();

      if (data.success) {
        form.classList.add('hidden');
        formSuccess?.classList.remove('hidden');
        track('contact_form_submitted');
      } else {
        // Show the server's reason (e.g. the rate-limit notice) instead of the generic text
        if (formError && typeof data.message === 'string') formError.textContent = data.message;
        formError?.classList.remove('hidden');
        setLoading(false);
      }
    } catch {
      if (formError) formError.textContent = genericError;
      formError?.classList.remove('hidden');
      setLoading(false);
    }
  });

  // ── Click-to-copy email ──────────────────────────────────────────────────
  const copyBtn = document.getElementById('copy-email-btn');
  const copyStatus = document.getElementById('copy-status');

  if (copyBtn) {
    let copyResetTimer: ReturnType<typeof setTimeout> | undefined;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(CONTACT_EMAIL);
        copyBtn.classList.add('is-copied');
        if (copyStatus) copyStatus.textContent = 'Email address copied to clipboard';
        clearTimeout(copyResetTimer);
        copyResetTimer = setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (copyStatus) copyStatus.textContent = '';
        }, 2000);
      } catch {
        // Clipboard unavailable — open email client as fallback
        window.location.href = `mailto:${CONTACT_EMAIL}`;
      }
    });
  }
</script>
