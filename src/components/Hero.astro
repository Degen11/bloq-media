---
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import { latestArticle } from '@lib/articles';
import { MAP_WIDTH, MAP_HEIGHT, cities } from '@lib/heroMap';

const facts = [
  { value: String(cities.length), label: 'regional hubs' },
  { value: '3', label: 'core services' },
  { value: '4', label: 'partner brands' },
];
---

<section
  data-hero
  class="relative overflow-hidden bg-bloq-tint bg-dots border-b border-bloq-line-strong/60"
>
  <!-- Decorative rings -->
  <div class="pointer-events-none" aria-hidden="true">
    <div class="absolute -right-[120px] -top-[160px] w-[520px] h-[520px] rounded-full border border-bloq-blue/25"></div>
    <div class="absolute -right-10 -top-20 w-[360px] h-[360px] rounded-full border border-bloq-blue/20"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 py-12 sm:py-16 lg:py-[72px] grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-12 lg:gap-14 items-center">
    <div>
      <p class="inline-flex items-center gap-2.5 rounded-full border border-[#d7e2f2] bg-white py-1.5 pl-1.5 pr-3.5 text-[13px] font-semibold text-bloq-navy">
        <span class="whitespace-nowrap rounded-full bg-bloq-navy px-2.5 py-0.5 text-xs uppercase tracking-[0.08em] text-white">
          News &amp; Media
        </span>
        <span class="whitespace-nowrap">
          Tech and blockchain<span class="hidden sm:inline">, Southeast Asia</span>
        </span>
      </p>

      <h1 class="mt-6 mb-5 text-[44px] sm:text-6xl lg:text-[68px] font-extrabold leading-[1.02] tracking-[-0.03em] text-bloq-dark">
        Shaping tech narratives in Southeast Asia
      </h1>

      <p class="mb-8 max-w-[520px] text-lg sm:text-[19px] leading-relaxed text-bloq-slate">
        Authoritative news coverage and strategic content for the tech and blockchain companies
        defining Southeast Asia's future.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 mb-10">
        <Button href="#contact" size="lg" class="shadow-[0_10px_24px_-10px_rgb(26_60_143/0.6)]">
          Start a project
          <Icon name="arrow-right" class="w-[18px] h-[18px]" />
        </Button>
        <Button href="#articles" variant="secondary" size="lg">
          Read the newsroom
        </Button>
      </div>

      <dl class="grid grid-cols-3 gap-3">
        {facts.map((fact) => (
          <div class="flex flex-col rounded-[14px] border border-bloq-line bg-white px-4 py-3.5 shadow-card">
            <dt class="order-2 text-[13px] leading-snug text-bloq-muted">{fact.label}</dt>
            <dd class="order-1 text-[26px] font-bold leading-tight text-bloq-dark">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Coverage map, pre-rendered at build time (src/pages/hero-map.svg.ts).
         Only shown at lg+. loading="lazy" matters: browsers never fetch lazy
         images inside a display:none container, so phones skip it entirely. -->
    <div class="hidden lg:block relative">
      <div
        class="rounded-3xl border border-[#dce5f2] bg-white p-5 shadow-[0_30px_60px_-30px_rgb(15_34_96/0.3)]"
        aria-hidden="true"
      >
        <div class="flex items-center justify-between px-1.5 pt-1 pb-3">
          <span class="text-xs font-bold uppercase tracking-[0.1em] text-bloq-muted">
            Our coverage map
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-bloq-link">
            <span class="w-2 h-2 rounded-full bg-bloq-blue"></span>
            Across Southeast Asia
          </span>
        </div>
        <div
          class="relative rounded-2xl bg-[#f7fafe]"
          style={`aspect-ratio: ${MAP_WIDTH} / ${MAP_HEIGHT};`}
        >
          <img
            src="/hero-map.svg"
            alt=""
            width={MAP_WIDTH}
            height={MAP_HEIGHT}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full"
          />
          {cities.map((city) => (
            <span
              class="absolute translate-x-2.5 -translate-y-1/2 whitespace-nowrap rounded-lg border border-[#d7e2f2] bg-white px-2 py-0.5 text-[11px] font-semibold text-bloq-dark shadow-[0_4px_10px_-4px_rgb(15_34_96/0.25)]"
              style={`left: ${city.left}; top: ${city.top};`}
            >
              {city.name}
            </span>
          ))}
        </div>
      </div>

      <a
        href={latestArticle.url}
        target="_blank"
        rel="noopener noreferrer"
        class="card absolute -left-9 -bottom-7 w-[300px] flex flex-col gap-1.5 px-[18px] py-4 shadow-[0_20px_40px_-20px_rgb(15_34_96/0.35)]"
      >
        <span class="text-[11px] font-bold uppercase tracking-[0.1em] text-bloq-link">
          Latest story · {latestArticle.tag}
        </span>
        <span class="text-base font-bold leading-snug text-bloq-dark">
          {latestArticle.shortTitle}
        </span>
        <span class="text-[13px] text-bloq-muted">Read on Medium</span>
      </a>
    </div>
  </div>
</section>
