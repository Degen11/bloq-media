---
import { MAP_WIDTH, MAP_HEIGHT, cities } from '../lib/heroMap';
---

<section data-hero class="relative min-h-[100svh] bg-gradient-to-br from-bloq-dark via-bloq-navy to-bloq-navy flex items-center pt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 py-12 sm:py-24 lg:py-28 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">

      <div>
        <div class="inline-flex items-center gap-2 bg-bloq-blue/20 border border-bloq-blue/30 text-bloq-blue text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-6 sm:mb-8">
          <span class="w-1.5 h-1.5 bg-bloq-blue rounded-full"></span>
          News &amp; Media
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] mb-6">
          Shaping Tech Narratives in <span class="text-bloq-blue">Southeast Asia</span>
        </h1>

        <p class="text-lg sm:text-xl text-white/65 mb-8 sm:mb-10 leading-relaxed">
          Authoritative news coverage and strategic content for the tech and blockchain companies defining Southeast Asia's future.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#contact"
            class="inline-flex items-center justify-center bg-bloq-blue text-white px-8 py-4 rounded-xl font-semibold text-base hover:bg-bloq-blue/90 active:scale-[0.97] transition-all duration-200 shadow-lg shadow-bloq-blue/25"
          >
            Get in Touch
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#about"
            class="inline-flex items-center justify-center border border-white/25 text-white px-8 py-4 rounded-xl font-semibold text-base hover:bg-white/10 active:scale-[0.97] transition-all duration-200"
          >
            Learn More
          </a>
        </div>
      </div>

      <!-- Decorative SEA map, pre-rendered at build time (src/pages/hero-map.svg.ts).
           Only shown at lg+. loading="lazy" matters: browsers never fetch lazy
           images inside a display:none container, so phones skip it entirely. -->
      <div class="hidden lg:flex items-center justify-center" aria-hidden="true">
        <div class="relative w-full" style={`aspect-ratio: ${MAP_WIDTH} / ${MAP_HEIGHT};`}>
          <img
            src="/hero-map.svg"
            alt=""
            width={MAP_WIDTH}
            height={MAP_HEIGHT}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full"
          />
          {cities.map((city) => (
            <div
              class="group absolute w-7 h-7 -translate-x-1/2 -translate-y-1/2"
              style={`left: ${city.left}; top: ${city.top};`}
            >
              <span class="absolute left-1/2 bottom-full mb-1 -translate-x-1/2 px-3 py-1.5 bg-black/50 backdrop-blur-sm border border-white/20 rounded-lg text-white text-xs font-semibold whitespace-nowrap pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                {city.name}
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white/5 to-transparent pointer-events-none"></div>
</section>

