---
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import { articles } from '@lib/articles';
import { MEDIUM_URL } from '@lib/site';
---

<Section id="articles" class="bg-bloq-tint">
  <div data-animate class="flex flex-wrap items-end justify-between gap-5 mb-9">
    <SectionHeading eyebrow="Latest work" title="From the newsroom" />
    <Button href={MEDIUM_URL} variant="secondary" target="_blank" rel="noopener noreferrer">
      All articles on Medium
      <Icon name="arrow-right" class="w-4 h-4" />
    </Button>
  </div>

  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-[1fr_1fr_0.75fr]">
    {articles.map((article, i) => (
      <a
        href={article.url}
        target="_blank"
        rel="noopener noreferrer"
        data-animate
        style={i > 0 ? `transition-delay: ${i * 100}ms` : undefined}
        class="card group overflow-hidden flex flex-col"
      >
        {/* Cover graphic (decorative): big label on a patterned panel */}
        {article.cover.tone === 'navy' ? (
          <div
            class="relative h-[200px] overflow-hidden bg-bloq-navy flex items-end p-5"
            aria-hidden="true"
          >
            <div class="absolute inset-0 bg-[radial-gradient(rgb(255_255_255/0.18)_1.5px,transparent_1.5px)] bg-[length:18px_18px]" />
            <div class="absolute -right-10 -top-10 w-[200px] h-[200px] rounded-full bg-bloq-blue/85" />
            <span class="relative text-[44px] font-extrabold tracking-tight text-white">
              {article.cover.label}
            </span>
          </div>
        ) : (
          <div
            class="relative h-[200px] overflow-hidden bg-bloq-sky flex items-end justify-end p-5"
            aria-hidden="true"
          >
            <div class="absolute left-6 top-6 w-16 h-16 rounded-[14px] border-[3px] border-bloq-navy" />
            <div class="absolute left-[70px] top-14 w-16 h-16 rounded-[14px] border-[3px] border-bloq-blue" />
            <div class="absolute left-[116px] top-[88px] w-16 h-16 rounded-[14px] bg-bloq-navy" />
            <span class="relative text-[44px] font-extrabold tracking-tight text-bloq-dark">
              {article.cover.label}
            </span>
          </div>
        )}
        <div class="p-6 flex flex-col gap-3 grow">
          <span class="self-start rounded-full bg-bloq-sky px-3 py-1 text-xs font-bold uppercase tracking-[0.06em] text-bloq-dark">
            {article.tag}
          </span>
          <h3 class="text-[22px] font-bold leading-tight text-bloq-dark">{article.title}</h3>
          <p class="grow text-[15px] leading-relaxed text-bloq-slate">{article.description}</p>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-bloq-navy">
            Read on Medium
            <Icon
              name="arrow-right"
              class="w-4 h-4 transition-transform motion-safe:group-hover:translate-x-1"
            />
          </span>
        </div>
      </a>
    ))}

    <div
      data-animate
      style={`transition-delay: ${articles.length * 100}ms`}
      class="md:col-span-2 lg:col-span-1 rounded-[20px] bg-bloq-dark p-7 flex flex-col justify-between gap-6 text-white"
    >
      <div class="flex flex-col gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-white/12 flex items-center justify-center">
          <Icon name="medium" class="w-[22px] h-[22px]" />
        </div>
        <h3 class="text-[26px] font-bold leading-tight">Follow the newsroom</h3>
        <p class="text-[15px] leading-relaxed text-bloq-mist">
          New stories on fintech, Web3 and the people building Southeast Asia's tech scene.
        </p>
      </div>
      <Button href={MEDIUM_URL} variant="light" target="_blank" rel="noopener noreferrer">
        Follow on Medium
      </Button>
    </div>
  </div>
</Section>
