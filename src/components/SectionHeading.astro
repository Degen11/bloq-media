---
import type { HTMLAttributes } from 'astro/types';

// Eyebrow + heading (+ optional intro paragraph from the default slot) used at
// the top of every section. `tone="dark"` is for navy backgrounds.
interface Props extends HTMLAttributes<'div'> {
  eyebrow: string;
  title: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2';
}

const {
  eyebrow,
  title,
  align = 'left',
  tone = 'light',
  as: Heading = 'h2',
  class: className,
  ...attrs
} = Astro.props;
const hasIntro = Astro.slots.has('default');
const dark = tone === 'dark';
---

<div class:list={[align === 'center' && 'text-center mx-auto', className]} {...attrs}>
  <p
    class:list={[
      'text-[13px] font-bold uppercase tracking-[0.12em] mb-3.5',
      dark ? 'text-bloq-blue-light' : 'text-bloq-link',
    ]}
  >
    {eyebrow}
  </p>
  <Heading
    class:list={[
      'text-4xl md:text-5xl font-extrabold leading-[1.05] tracking-tight',
      dark ? 'text-white' : 'text-bloq-dark',
      hasIntro && 'mb-4',
    ]}
  >
    {title}
  </Heading>
  {hasIntro && (
    <p class:list={['text-[17px] leading-relaxed', dark ? 'text-bloq-mist' : 'text-bloq-slate']}>
      <slot />
    </p>
  )}
</div>
