---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import blockchainSpaceLogo from '@assets/blockchainspace-logo.jpg';
import cbrMediaLogo from '@assets/cbr-media.jpg';
import meeOppLogo from '@assets/meeopp.png';
import zCloakLogo from '@assets/zcloak-network-logo.png';

interface Client {
  name: string;
  logo: ImageMetadata;
  logoClass?: string;
}

const clients: Client[] = [
  { name: 'Blockchain Space', logo: blockchainSpaceLogo, logoClass: 'max-h-11' },
  { name: 'CBR Media', logo: cbrMediaLogo, logoClass: 'max-h-14' },
  { name: 'MeeOpp', logo: meeOppLogo },
  { name: 'zCloak Network', logo: zCloakLogo },
];
---

<!-- Client logo strip, directly under the hero -->
<section id="clients" class="bg-white border-b border-bloq-line">
  <div class="max-w-7xl mx-auto px-6 py-9 grid grid-cols-2 gap-3 md:gap-6 lg:grid-cols-[auto_repeat(4,minmax(0,1fr))] lg:gap-10 items-center">
    <h2 class="col-span-2 lg:col-span-1 text-[13px] font-semibold leading-snug text-bloq-muted text-center lg:text-left">
      Trusted by teams
      <br class="hidden lg:block" /> building in the region
    </h2>
    {clients.map((client) => (
      <div class="flex items-center justify-center p-4 md:p-6 lg:p-0 h-20">
        <Image
          src={client.logo}
          alt={client.name}
          height={112}
          loading="lazy"
          decoding="async"
          class={`${client.logoClass ?? 'max-h-10'} w-auto max-w-full object-contain`}
        />
      </div>
    ))}
  </div>
</section>
