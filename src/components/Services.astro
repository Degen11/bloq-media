---
import Icon from '@components/Icon.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import type { IconName } from '@lib/icons';

interface Service {
  title: string;
  description: string;
  icon: IconName;
}

const services: Service[] = [
  {
    title: 'Content Strategy',
    description:
      "A clear editorial plan tailored to your audience, goals, and the platforms they use. We map out what to publish, where, and how to measure whether it's working.",
    icon: 'pencil',
  },
  {
    title: 'Digital Marketing',
    description:
      "SEO, social, and targeted campaigns designed for the tech and blockchain audience. We get your brand in front of founders, investors, and early adopters — where they actually spend time.",
    icon: 'megaphone',
  },
  {
    title: 'News & Thought Leadership',
    description:
      "Original articles, market reports, and op-eds that earn attention rather than fill column inches. We help you say something worth reading — and build the credibility that comes with it.",
    icon: 'newspaper',
  },
];
---

<Section id="services" class="bg-white">

  <SectionHeading data-animate align="center" class="max-w-2xl mb-16" eyebrow="What We Offer" title="Our Services" />

  <div class="grid md:grid-cols-3 gap-8">
    {services.map((service, i) => (
      <div
        data-animate
        style={i > 0 ? `transition-delay: ${i * 100}ms` : undefined}
        class="card group flex flex-col"
      >
        <div class="w-12 h-12 bg-bloq-blue/10 rounded-xl flex items-center justify-center text-bloq-navy group-hover:bg-bloq-navy group-hover:text-white transition-all duration-300 mb-6">
          <Icon name={service.icon} class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-4">{service.title}</h3>
        <p class="text-gray-500 leading-relaxed text-sm flex-1">{service.description}</p>
        <a
          href="#contact"
          class="group/cta mt-6 inline-flex items-center text-bloq-navy font-semibold text-sm hover:text-bloq-blue transition-colors"
        >
          <span class="group-hover/cta:underline underline-offset-4 decoration-2">Get in touch</span>
          <Icon name="arrow-right" class="ml-1.5 w-4 h-4 transition-transform duration-200 group-hover/cta:translate-x-1" />
        </a>
      </div>
    ))}
  </div>

</Section>
