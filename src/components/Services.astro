---
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import Section from '@components/Section.astro';
import SectionHeading from '@components/SectionHeading.astro';
import type { IconName } from '@lib/icons';

interface Service {
  title: string;
  description: string;
  icon: IconName;
}

const services: Service[] = [
  {
    title: 'Content strategy',
    description:
      "A clear editorial plan tailored to your audience, goals, and the platforms they use. We map out what to publish, where, and how to measure whether it's working.",
    icon: 'pencil',
  },
  {
    title: 'Digital marketing',
    description:
      'SEO, social, and targeted campaigns designed for the tech and blockchain audience. We get your brand in front of founders, investors, and early adopters, where they actually spend time.',
    icon: 'megaphone',
  },
  {
    title: 'News & thought leadership',
    description:
      'Original articles, market reports, and op-eds that earn attention rather than fill column inches. We help you say something worth reading and build the credibility that comes with it.',
    icon: 'newspaper',
  },
];
---

<Section id="services" class="bg-white">
  <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-14 items-start">
    <div data-animate class="flex flex-col gap-6">
      <SectionHeading eyebrow="What we offer" title="Three ways we get your story told.">
        Pick one, or combine them into a full campaign.
      </SectionHeading>
      <div class="rounded-[20px] bg-bloq-sky p-6 flex flex-col gap-3">
        <p class="text-xl font-bold text-bloq-dark">Not sure where to start?</p>
        <p class="text-[15px] leading-relaxed text-[#3a4763]">
          Tell us what you're launching and we'll suggest a mix.
        </p>
        <Button href="#contact" size="sm" class="self-start">
          Talk to us
          <Icon name="arrow-right" class="w-4 h-4" />
        </Button>
      </div>
    </div>

    <ol class="border-t border-bloq-line">
      {services.map((service, i) => (
        <li data-animate style={i > 0 ? `transition-delay: ${i * 100}ms` : undefined}>
          <a
            href="#contact"
            class="group flex flex-wrap sm:flex-nowrap gap-4 sm:gap-[22px] items-start px-2 sm:px-4 py-7 border-b border-bloq-line rounded hover:bg-bloq-tint/50 transition-colors"
          >
            <span
              class="hidden sm:block w-7 pt-1.5 text-[15px] font-bold text-bloq-link"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="shrink-0 w-[52px] h-[52px] rounded-[14px] bg-bloq-tint text-bloq-navy flex items-center justify-center">
              <Icon name={service.icon} class="w-6 h-6" />
            </span>
            <div class="contents sm:block sm:grow">
              <h3 class="flex-1 self-center sm:self-auto text-2xl font-bold text-bloq-dark sm:mb-2">
                {service.title}
              </h3>
              <p class="basis-full order-last sm:order-none text-[15px] leading-relaxed text-bloq-slate">
                {service.description}
              </p>
            </div>
            <Icon
              name="arrow-up-right"
              class="shrink-0 mt-1.5 w-[22px] h-[22px] text-bloq-navy transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
            />
          </a>
        </li>
      ))}
    </ol>
  </div>
</Section>
