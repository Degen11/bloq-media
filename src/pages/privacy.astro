---
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { TEAM_EMAIL } from '@lib/site';
---

<Layout
  title="Privacy Policy | BLOQ Media"
  description="How BLOQ Media collects, uses, and protects the information you share through bloq.media, including contact form submissions and anonymous analytics."
>
  <Navbar />
  <main id="main" class="pt-32 pb-20 sm:pb-24 bg-white">
    <article class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3">Privacy Policy</h1>
      <p class="text-sm text-gray-500 mb-10">Last updated: April 2026</p>
      <div class="legal-content">
        <h2>Information We Collect</h2>
        <p>
          When you contact us through our website, we collect the information you provide: your
          name, email address, company name, and message. We also collect anonymous analytics data
          through Vercel Analytics to understand how visitors use our site.
        </p>

        <h2>How We Use Your Information</h2>
        <ul>
          <li>To respond to your inquiries and provide our services</li>
          <li>To improve our website and user experience</li>
          <li>To send relevant information about our services, where you have consented</li>
        </ul>
        <p>
          We do not sell, trade, or otherwise transfer your personal information to third parties
          without your consent, except as described below.
        </p>

        <h2>Third-Party Services</h2>
        <ul>
          <li>
            <strong>Vercel Analytics</strong>: We use Vercel Analytics to collect anonymous,
            aggregated usage data. No personally identifiable information is shared with Vercel for
            analytics purposes.
          </li>
          <li>
            <strong>Web3Forms / Resend</strong>: Contact form submissions are processed through
            these services solely to deliver your message to our team. Your data is not used by
            these services for any other purpose.
          </li>
        </ul>

        <h2>Data Retention</h2>
        <p>
          We retain contact form submissions for as long as necessary to respond to your inquiry and
          for legitimate business record-keeping purposes, typically no longer than 2 years.
        </p>

        <h2>Your Rights</h2>
        <p>
          Depending on your jurisdiction, you may have the right to access, correct, delete, or
          restrict processing of your personal data. To exercise these rights, contact us at{' '}
          <a href={`mailto:${TEAM_EMAIL}`}>{TEAM_EMAIL}</a>.
        </p>

        <h2>Cookies</h2>
        <p>
          Our website uses minimal, functional cookies required for site operation. Analytics data
          collected by Vercel Analytics is anonymous and does not use tracking cookies.
        </p>

        <h2>Governing Law</h2>
        <p>
          This Privacy Policy is governed by the laws of Singapore. Any disputes arising from this
          policy shall be subject to the exclusive jurisdiction of the courts of Singapore.
        </p>

        <h2>Contact</h2>
        <p>
          For any privacy-related questions, please contact us at{' '}
          <a href={`mailto:${TEAM_EMAIL}`}>{TEAM_EMAIL}</a>.
        </p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
